#!/usr/bin/env bash

# Displays branches for fuzzy selection, switches to the selected branch.
# Branches checked out in other worktrees are excluded.
# $* contains any arguments passed to git branch
#
# Dependencies: fzf (install using homebrew)
#
# Examples:
#   git switch-branch
#   git switch-branch --all

# If including remote branches, fetch first
if [[ "$1" =~ "--all" ]]; then
  echo "Fetching from remote..."
  git fetch
fi

# select a branch to switch to
selected_branch="$(
  git branch "$@" |
    grep -v '^+ ' |
    grep -v -e ' -> ' -e '(HEAD detached' |
    cut -c 3- |
    awk '{ d = $0; if (match(d, /^remotes\/[^\/]+\//)) { r = substr(d, 9, RLENGTH - 9); d = "remote (" r "): " substr(d, RLENGTH + 1) } printf "%s\t%s\n", $0, d }' |
    fzf --no-multi --delimiter=$'\t' --with-nth=2 \
      --preview='printf "[%s]\n\n" {1} && git log --format=extended --color=always {1}' \
      --preview-window=up,80% |
    cut -f1
)"

current_head="$(git rev-parse --abbrev-ref HEAD)"

if [[ -z $selected_branch || $selected_branch == "$current_head" ]]; then
  exit 0
fi

if [[ $selected_branch =~ ^remotes ]]; then
  remote_branch="${selected_branch#remotes\/}"
  local_branch="${remote_branch#*/}"

  if git show-ref --verify --quiet "refs/heads/$local_branch"; then
    git switch "$local_branch"
  else
    git switch --track "$remote_branch"
  fi
else
  git switch "$selected_branch"
fi
