#!/usr/bin/env bash

# Displays worktrees for fuzzy selection, then opens a shell in the selected
# worktree. The current worktree is excluded.
#
# A script cannot change the directory of the calling shell. Use --print to
# print the selected path instead, for example:
#   cd "$(git switch-worktree --print)"
#
# Dependencies: fzf (install using homebrew)
#
# Examples:
#   git switch-worktree
#   git switch-worktree --print

print_only=false
[[ "$1" == "--print" ]] && print_only=true

current_path="$(git rev-parse --show-toplevel)"

export CURRENT_WORKTREE="$current_path"

# Each line is "<path><TAB><name>  [<branch>]<TAB><~/path [branch]>"; fzf lists
# the second field and uses the third as the preview headline
list_worktrees() {
  git worktree list --porcelain |
    awk -v current="$CURRENT_WORKTREE" -v home="$HOME" '
      function add() {
        if (path == "" || path == current) return
        n++
        paths[n] = path
        split(path, parts, "/")
        names[n] = parts[length(parts)]
        labels[n] = label
        if (length(names[n]) > width) width = length(names[n])
      }
      /^worktree / { add(); path = substr($0, 10); label = "(unknown)" }
      /^branch /   { label = substr($0, 8); sub("^refs/heads/", "", label) }
      /^detached/  { label = "detached" }
      /^bare/      { label = "bare" }
      END {
        add()
        for (i = 1; i <= n; i++) {
          full = paths[i]
          if (index(full, home "/") == 1) full = "~" substr(full, length(home) + 1)
          printf "%s\t%-*s [%s]\t%s [%s]\n", paths[i], width, names[i], labels[i], full, labels[i]
        }
      }
    '
}

# preview <mode> <path> <headline>
preview() {
  printf '%s\n\n' "$3"
  case "$1" in
    status) git -C "$2" status -sb --untracked-files=all ;;
    diff) git -C "$2" diff --color=always HEAD ;;
    *) git -C "$2" log --format=extended --color=always -n 20 ;;
  esac
}

remove_worktree() {
  read -r -p "Remove worktree $1? [y/N] " answer </dev/tty
  [[ $answer == [yY] ]] && git worktree remove "$1" 2>&1 | tail -n 3
  sleep 1
}

create_worktree() {
  local branch dir
  branch="$(git branch --format='%(refname:short)' |
    fzf --no-multi --prompt='branch> ' \
      --preview='git log --format=extended --color=always {}' \
      --preview-window=up,80%)" || return 0
  [[ -z $branch ]] && return 0
  dir="$(dirname "$CURRENT_WORKTREE")/$(basename "$CURRENT_WORKTREE")-${branch//\//-}"
  read -r -e -i "$dir" -p "Path: " dir </dev/tty
  [[ -z $dir ]] && return 0
  git worktree add "$dir" "$branch" 2>&1 | tail -n 3
  sleep 1
}

export -f list_worktrees preview remove_worktree create_worktree

# Keys: ctrl-l log, ctrl-t status, ctrl-d diff vs HEAD, ctrl-x remove, ctrl-w create
selected="$(
  SHELL="$(command -v bash)" list_worktrees |
    SHELL="$(command -v bash)" fzf --no-multi --delimiter=$'\t' --with-nth=2 \
      --header='ctrl-l log | ctrl-t status | ctrl-d diff | ctrl-x remove | ctrl-w new' \
      --preview='preview log {1} {3}' \
      --preview-window=up,80% \
      --bind='ctrl-l:change-preview(preview log {1} {3})' \
      --bind='ctrl-t:change-preview(preview status {1} {3})' \
      --bind='ctrl-d:change-preview(preview diff {1} {3})' \
      --bind='ctrl-x:execute(remove_worktree {1})+reload(list_worktrees)' \
      --bind='ctrl-w:execute(create_worktree)+reload(list_worktrees)'
)"

if [[ -z $selected ]]; then
  exit 0
fi

selected_path="${selected%%$'\t'*}"

if $print_only; then
  echo "$selected_path"
else
  cd "$selected_path" && exec "${SHELL:-/bin/bash}"
fi
