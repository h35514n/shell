#!/usr/bin/env python3
"""Convert a Jira "Word" export (.doc) to Markdown on STDOUT, or to a file with -f."""
import argparse
import json
import re
import shutil
import subprocess
import sys
from pathlib import Path


def pandoc(body, fmt, *opts):
    return subprocess.run(
        ["pandoc", "-f", "html", "-t", fmt, "--wrap=none", *opts],
        input=body, text=True, capture_output=True, check=True,
    ).stdout


def parse(path):
    """Run jira2json, preferring the copy next to this script."""
    sibling = Path(__file__).resolve().parent / "jira2json"
    exe = str(sibling) if sibling.exists() else shutil.which("jira2json")
    if not exe:
        sys.exit("jira2json not found")
    r = subprocess.run([exe, str(path)], text=True, capture_output=True)
    if r.returncode:
        sys.exit(r.stderr.strip())
    return json.loads(r.stdout)


def cli(description, convert, suffix):
    ap = argparse.ArgumentParser(description=description)
    ap.add_argument("input", type=Path, help="Jira export (.doc)")
    ap.add_argument("-f", "--file", action="store_true",
                    help=f"write {suffix} file next to input instead of STDOUT")
    args = ap.parse_args()
    content = convert(parse(args.input))
    if args.file:
        out = args.input.with_suffix(suffix)
        out.write_text(content, encoding="utf-8")
        print(f"Wrote {out}", file=sys.stderr)
    else:
        sys.stdout.write(content)



def demote_headings(md):
    return re.sub(r"^(#+) ", lambda m: "#" + m.group(1) + " ", md, flags=re.M)


def description(body):
    out = pandoc(body, "gfm")
    out = re.sub(r"^(#+) \*\*(.+?)\*\*\s*$", r"\1 \2", out, flags=re.M)
    out = re.sub(r"^(\d+\.)\s+", r"\1 ", out, flags=re.M)
    return re.sub(r"\n{3,}", "\n\n", out).strip()


def convert(t):
    lines = [f"# {t['key']}: {t['title']}", ""]
    if t["url"]:
        lines += [f"<{t['url']}>", ""]
    lines += ["| Field | Value |", "| --- | --- |"]
    lines += [f"| {k} | {v.replace('|', chr(92) + '|')} |" for k, v in t["rows"]]
    lines += ["", "## Description", "", demote_headings(description(t["body"])), ""]
    return "\n".join(lines)


if __name__ == "__main__":
    cli(__doc__, convert, ".md")
