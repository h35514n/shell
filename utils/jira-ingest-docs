#!/usr/bin/env bash
# Move Jira .doc exports from ~/Downloads into the tickets directory, convert
# each to .md, .org, and .jira, then trash the .doc. Never overwrite files.
# Only files that were in ~/Downloads at start are processed. When there is
# only one, its org output goes to the clipboard instead of a file.
set -euo pipefail
shopt -s nullglob

usage() {
  echo "Usage: ${0##*/} [md] [org] [jira]   (default: md)" >&2
  exit 1
}

formats=("$@")
[[ ${#formats[@]} -eq 0 ]] && formats=(md)
for f in "${formats[@]}"; do
  case "$f" in
    md|org|jira) ;;
    *) echo "Unknown format: $f" >&2; usage ;;
  esac
done

SRC_DIR="$HOME/Downloads"
DEST_DIR="/Users/jromer/Knowledge/work/tickets"

mkdir -p "$DEST_DIR"

# Step 1: move .doc files
incoming=("$SRC_DIR"/*.doc)
for doc in "${incoming[@]}"; do
  target="$DEST_DIR/$(basename "$doc")"
  if [[ -e "$target" ]]; then
    echo "Already exists, skipping move: $target"
    continue
  fi
  mv -n "$doc" "$target"
  echo "Moved: $doc -> $target"
done

# Step 2: convert each incoming .doc, then trash it once all outputs exist
for src in "${incoming[@]}"; do
  doc="$DEST_DIR/$(basename "$src")"
  [[ -e "$doc" ]] || continue
  base="${doc%.doc}"
  all_present=true
  for ext in "${formats[@]}"; do
    out="$base.$ext"
    # A single doc's org output goes to the clipboard instead of a file.
    if [[ $ext == org && ${#incoming[@]} -eq 1 ]]; then
      if jiradoc2org "$doc" | pbcopy; then
        echo "Copied org output to clipboard: $doc"
      else
        all_present=false
      fi
      continue
    fi
    if [[ -e "$out" ]]; then
      echo "Already exists, skipping: $out"
      continue
    fi
    "jiradoc2$ext" -f "$doc"
    echo "Created: $out"
    [[ -e "$out" ]] || all_present=false
  done

  if $all_present; then
    trash "$doc"
    echo "Trashed: $doc"
  else
    echo "Keeping $doc: not all outputs exist"
  fi
done
