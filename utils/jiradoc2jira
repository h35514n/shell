#!/usr/bin/env python3
"""Convert a Jira "Word" export (.doc) to Jira wiki markup on STDOUT, or to a .jira file with -f."""
import argparse
import json
import re
import shutil
import subprocess
import sys
from pathlib import Path


def pandoc(body, fmt, *opts):
    return subprocess.run(
        ["pandoc", "-f", "html", "-t", fmt, "--wrap=none", *opts],
        input=body, text=True, capture_output=True, check=True,
    ).stdout


def parse(path):
    """Run jiradoc2json, preferring the copy next to this script."""
    sibling = Path(__file__).resolve().parent / "jiradoc2json"
    exe = str(sibling) if sibling.exists() else shutil.which("jiradoc2json")
    if not exe:
        sys.exit("jiradoc2json not found")
    r = subprocess.run([exe, str(path)], text=True, capture_output=True)
    if r.returncode:
        sys.exit(r.stderr.strip())
    return json.loads(r.stdout)


def cli(description, convert, suffix):
    ap = argparse.ArgumentParser(description=description)
    ap.add_argument("input", type=Path, help="Jira export (.doc)")
    ap.add_argument("-f", "--file", action="store_true",
                    help=f"write {suffix} file next to input instead of STDOUT")
    ap.add_argument("-v", "--verbose", action="store_true",
                    help="report the written file on STDERR")
    args = ap.parse_args()
    content = convert(parse(args.input))
    if args.file:
        out = args.input.with_suffix(suffix)
        out.write_text(content, encoding="utf-8")
        if args.verbose:
            print(f"Wrote {out}", file=sys.stderr)
    else:
        sys.stdout.write(content)



def description(body):
    out = pandoc(body, "jira")
    out = re.sub(r"\{anchor:[^}]*\}", "", out)
    return re.sub(r"\n{3,}", "\n\n", out).strip()


def convert(t):
    head = f"[{t['key']}|{t['url']}]" if t["url"] else t["key"]
    lines = [f"h1. {head}: {t['title']}", "", "||Field||Value||"]
    lines += [f"|{k}|{v.replace('|', chr(92) + '|')}|" for k, v in t["rows"]]
    lines += ["", "h2. Description", "", description(t["body"]), ""]
    return "\n".join(lines)


if __name__ == "__main__":
    cli(__doc__, convert, ".jira")
