#!/usr/bin/env python3
"""Convert a Jira "Word" export (.doc) to Org on STDOUT, or to a file with -f."""
import argparse
import json
import re
import shutil
import subprocess
import sys
from pathlib import Path


def pandoc(body, fmt, *opts):
    return subprocess.run(
        ["pandoc", "-f", "html", "-t", fmt, "--wrap=none", *opts],
        input=body, text=True, capture_output=True, check=True,
    ).stdout


def parse(path):
    """Run jira2json, preferring the copy next to this script."""
    sibling = Path(__file__).resolve().parent / "jira2json"
    exe = str(sibling) if sibling.exists() else shutil.which("jira2json")
    if not exe:
        sys.exit("jira2json not found")
    r = subprocess.run([exe, str(path)], text=True, capture_output=True)
    if r.returncode:
        sys.exit(r.stderr.strip())
    return json.loads(r.stdout)


def cli(description, convert, suffix):
    ap = argparse.ArgumentParser(description=description)
    ap.add_argument("input", type=Path, help="Jira export (.doc)")
    ap.add_argument("-f", "--file", action="store_true",
                    help=f"write {suffix} file next to input instead of STDOUT")
    args = ap.parse_args()
    content = convert(parse(args.input))
    if args.file:
        out = args.input.with_suffix(suffix)
        out.write_text(content, encoding="utf-8")
        print(f"Wrote {out}", file=sys.stderr)
    else:
        sys.stdout.write(content)



def description(body):
    out = pandoc(body, "org", "--wrap=auto", "--columns=72")
    out = re.sub(r"^:PROPERTIES:\n:CUSTOM_ID: .*\n:END:\n", "", out, flags=re.M)
    out = re.sub(r"^(\*+) ", lambda m: "**" + m.group(1) + " ", out, flags=re.M)
    return re.sub(r"\n{3,}", "\n\n", out).strip()


PROPERTY_NAMES = {
    "Component/s": "COMPONENTS",
    "Team(s)": "TEAMS",
    "Fix Version/s": "FIX_VERSIONS",
}


def prop_name(label):
    name = PROPERTY_NAMES.get(label, label)
    return re.sub(r"\W+", "_", name).strip("_").upper()


def convert(t):
    head = f"[[{t['url']}][{t['key']}]]" if t["url"] else t["key"]
    lines = [f"** {head}: {t['title']}", ":PROPERTIES:", ":VISIBILITY: folded"]
    lines += [f":{prop_name(k)}: {v}" for k, v in t["rows"]]
    lines += [":END:", description(t["body"]), ""]
    return "\n".join(lines)


if __name__ == "__main__":
    cli(__doc__, convert, ".org")
